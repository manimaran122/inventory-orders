###############################################################################
# Example environment configuration.
#
# Copy this file to `.env` and fill in real values for your machine:
#     cp .env.example .env && php artisan key:generate
#
# This file is committed to version control, so it must NEVER contain real
# secrets, passwords, API keys or production hostnames. Every value below is a
# safe placeholder.
###############################################################################

APP_NAME="Inventory & Orders"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
# Keep APP_DEBUG=false in any non-local environment: when true, Laravel renders
# stack traces and environment variables in error responses.
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database
#
# This project targets MySQL 8 / MariaDB because it relies on InnoDB row-level
# locking (SELECT ... FOR UPDATE) to prevent overselling stock. SQLite will run
# the app but cannot demonstrate the concurrency guarantees - see SECURITY.md.
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_orders
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Separate database used by the automated test suite. The suite migrates and
# rolls back these tables, so it must never point at a database with real data.
DB_TEST_DATABASE=inventory_orders_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

###############################################################################
# Queue
#
# Order confirmations are dispatched to a queued job. `database` keeps jobs in
# the `jobs` table and requires a worker: php artisan queue:work
# Use `sync` to run jobs inline (no worker needed) when debugging.
###############################################################################
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes "sent" mail to storage/logs/laravel.log - no SMTP server needed.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@example.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Application business rules
###############################################################################

# Default threshold used by GET /api/products/low-stock when no `threshold`
# query parameter is supplied.
INVENTORY_LOW_STOCK_THRESHOLD=10

# Maximum threshold a client may request, to stop someone passing a huge value
# and dumping the entire product catalogue in one call.
INVENTORY_LOW_STOCK_MAX_THRESHOLD=1000

# Maximum number of distinct line items permitted in a single order.
INVENTORY_MAX_ORDER_ITEMS=50

# Maximum quantity permitted for a single line item.
INVENTORY_MAX_LINE_QUANTITY=1000

# Display currency. The symbol is used by the UI money component and the order
# builder preview; amounts are stored as DECIMAL and never as floats.
INVENTORY_CURRENCY=INR
INVENTORY_CURRENCY_SYMBOL=₹
